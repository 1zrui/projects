# ============================================================
# 律动(BlockBeats)快讯推送 · 配置模板
# 用法：把本文件复制成 .env 并填值。  .env 不要进 git！
# 优先级：真实环境变量 > .env 文件（systemd 的 EnvironmentFile 也是走环境变量）
# ============================================================

# ---------- 必填：QQ 官方机器人凭证（在 QQ 开放平台机器人后台拿）----------
QQ_APP_ID=1905578231
QQ_CLIENT_SECRET=填你的机器人 AppSecret

# ---------- 必填：目标群 openid ----------
# 注意：这是「机器人 × 该群」的内部串，不是 QQ 群号。
# 631502972 这个群的 openid 已内置为默认值；换群要先让机器人在群里被 @ 一次，再从网关日志拿。
# BB_GROUP_OPENID=8DDF1613C07205222566826C231D9201

# ---------- 可选：拉取与网络 ----------
# 拉取间隔（秒），默认 20
# BB_POLL=20
# 数据源（默认官网快讯列表页 SSR；这个址变了就改这里）
# BB_SOURCE_URL=https://www.theblockbeats.info/newsflash/rss
# 代理兜底：直连失败时用。云服务器上本机 v2rayA 是 http://127.0.0.1:20171 ；留空=不用代理
# BB_PROXY=http://127.0.0.1:20171

# ---------- 可选：路径（默认都在项目目录内，一般不用改）----------
# BB_STATE_FILE=/opt/blockbeats-push/state/last_id.json
# BB_LOG_FILE=/opt/blockbeats-push/logs/listener.log
# BB_CACHE_DIR=/opt/blockbeats-push/cache

# ---------- 可选：字体（Linux 上装了 fonts-noto-cjk 就能自动找到）----------
# BB_FONT_REGULAR=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# BB_FONT_BOLD=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
